# Runtime configuration for the Vercel chat app.
# Copy this file to `.env` for local development and fill in every value.

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use a long, random value in production.
ROOM_LINK_SECRET=
ROOM_TTL_SECONDS=21600
MAX_MESSAGES_PER_ROOM=500

# Ably API key (keep this server-side; it is never sent to the browser)
ABLY_API_KEY=

# S3 or Cloudflare R2
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
